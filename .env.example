# Vision AI Configuration
# Copy this file to .env and fill in your actual values
# Deployed endpoint example:
# VISION_API_URL=https://predict-xxxx.a.run.app/predict
VISION_API_URL=https://predict.ultralytics.com
VISION_API_KEY=YOUR_API_KEY_HERE
# Optional for direct Ultralytics cloud endpoint (usually not needed for deployed /predict endpoint)
VISION_MODEL_URL=https://hub.ultralytics.com/models/YOUR_MODEL_ID_HERE

# Optional inference args
VISION_CONF=0.25
VISION_IOU=0.7
VISION_IMGSZ=640
